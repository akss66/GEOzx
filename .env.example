# ───────────────────────────────────────────────────────────────
# DyFlow 环境变量样例。复制为 .env 并填入真实值；.env 绝不入库。
#   cp .env.example .env
# ───────────────────────────────────────────────────────────────

# ── 运行环境 ──
ENVIRONMENT=development

# ── PostgreSQL ──
POSTGRES_USER=dyflow
POSTGRES_PASSWORD=dyflow_dev_pw
POSTGRES_DB=dyflow
# 容器内服务名为 postgres；本机直连可改为 localhost
DATABASE_URL=postgresql+asyncpg://dyflow:dyflow_dev_pw@postgres:5432/dyflow

# ── Redis（事件总线 / arq 队列）──
REDIS_URL=redis://redis:6379/0

# ── 对象存储（v1 用本地卷，MinIO 接口预留）──
STORAGE_BACKEND=local            # local | minio
STORAGE_LOCAL_DIR=/data/objects  # 容器内本地卷挂载点
MINIO_ROOT_USER=dyflow
MINIO_ROOT_PASSWORD=dyflow_dev_pw
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=dyflow

# ── 认证（JWT）──
JWT_SECRET=dev-only-change-me-please-min-32-bytes-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# ── 初始管理员种子（首次启动用 app/seed.py 创建）──
ADMIN_EMAIL=admin@dyflow.local
ADMIN_PASSWORD=admin12345
DEFAULT_ORG_NAME=DyFlow

# ── 大模型网关（v1 默认 DeepSeek）──
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── 外部集成（M1 起接入；现在留空）──
# Seedance（豆包视频生成，火山引擎方舟 Ark 平台）
SEEDANCE_API_KEY=
SEEDANCE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDANCE_MODEL=doubao-seedance-1-5-pro
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=

# ── 前端可访问的后端地址（构建期注入；容器内由 nginx 代理 /api）──
VITE_API_BASE=/api
